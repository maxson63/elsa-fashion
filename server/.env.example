# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/elsa-fashion

# JWT Secret
JWT_SECRET=your-jwt-secret-key

# Session Secret
SESSION_SECRET=your-session-secret-key

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://elsa-fashion-backend.onrender.com/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=https://elsafashion.netlify.app

# Port
PORT=5000
