{
  "name": "elsa-fashionis",
  "version": "1.0.0",
  "description": "Elsa Fashionis - Outfit shopping web app with collaboration features",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install-all": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.9",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "stripe": "^13.6.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "fashion",
    "ecommerce",
    "collaboration",
    "outfits"
  ],
  "author": "Elsa Fashionis",
  "license": "MIT"
}
